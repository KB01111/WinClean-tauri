{
  "name": "winclean",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-frontend.cjs",
    "build": "bun scripts/build-frontend.cjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "bun test",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "release:check": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/eslint/bin/eslint.js . && bun test && bun scripts/build-frontend.cjs && cargo test --manifest-path src-tauri/Cargo.toml && node node_modules/@tauri-apps/cli/tauri.js build --no-bundle",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1"
  }
}
